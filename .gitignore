# =============================================
# Anveshak — Lunar Mission Planner .gitignore
# =============================================

# --- NASA DEM data files (too large for git) ---
data/
!data/.gitkeep
!data/dem/.gitkeep
!data/results/.gitkeep
!data/bundled/

# --- Session uploads and temp files ---
uploads/
temp/

# --- User auth database (auto-created on startup) ---
users.db

# --- Trained ML model binaries ---
models/*.pkl

# --- Python bytecode ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# --- Environment secrets ---
.env
.env.*
!.env.example

# --- Conda environments ---
envs/
conda-env/
lunar-planner/
anveshak-env/
*.conda

# --- GDAL/rasterio aux files ---
*.aux
*.aux.xml
*.ovr
*.prj

# --- Outputs: keep HTML (small ones), exclude images and large reports ---
outputs/**/*.png
outputs/**/*.jpg
outputs/**/*.tif
outputs/*.png
outputs/*.jpg
outputs/*.tif
outputs/COMBINATIONS_REPORT.html

# --- Generated report documents ---
*.docx
*.pdf
"Guideline of Report.docx"

# --- Temporary / scratch files ---
_tmp_*.py
*.tmp
*.bak
~$*

# --- IDE ---
.vscode/
.idea/
*.code-workspace

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Logs ---
*.log
logs/
