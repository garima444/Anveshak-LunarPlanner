# Anveshak — environment variable template
# Copy to .env and fill in values for local development.
# Never commit .env to git.

PORT=8000
DEMO_MODE=false
SECRET_KEY=change-this-in-production
# DEM files can reach 3–5 GB (LOLA 5 m/px product).
# Files are streamed in 8 MB chunks; server disk must have matching headroom.
MAX_DEM_SIZE_MB=5120
MAX_ANCILLARY_SIZE_MB=500
SESSION_EXPIRE_HOURS=4
